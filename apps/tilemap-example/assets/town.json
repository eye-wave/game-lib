  "legend": {
   "1": {
    "script": [
     {
      "say": "Welcome! Walk with WASD or the arrow keys. Hold Shift to run."
     },
     {
      "say": "Press Z next to a sign to read it. Q and E zoom the camera."
     }
    ]
   },
   "2": {
    "script": [
     {
      "say": "A patch of sand. Its edges are chosen by looking at the 8 neighbours of every cell."
     },
     {
      "say": "See the little grass hole? That is just one cell of another kind."
     }
    ]
   },
   "3": {
    "script": [
     {
      "say": "Cobblestone road. The whole ground is one quad drawn by one fragment shader."
     },
     {
      "say": "The things standing on it are a second layer, read from a second texture. East of here a gate leads to the garden."
     }
    ]
   },
   "4": {
    "script": [
     {
      "say": "These bushes block the way. Try walking into them."
     },
     {
      "say": "You slide along them, because movement is resolved one axis at a time."
     }
    ]
   },
   "5": {
    "script": [
     {
      "ask": {
       "text": "An old well. Drop a coin in?",
       "options": [
        {
         "text": "Yes",
         "then": [
          {
           "say": "Plink... a faint splash far below. Make a wish!"
          }
         ]
        },
        {
         "text": "No",
         "then": [
          {
           "say": "You keep your coin. Maybe next time."
          }
         ]
        }
       ]
      }
     },
     {
      "say": "The water looks very deep."
     }
    ]
